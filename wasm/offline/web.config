<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuracion para servir el Taller Offline con IIS Express (Microsoft).
     Solo agrega tipos MIME que el taller necesita; nada mas. Auditable. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".wasm" /><mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".whl" /><mimeMap fileExtension=".whl" mimeType="application/octet-stream" />
      <remove fileExtension=".ipynb" /><mimeMap fileExtension=".ipynb" mimeType="application/json" />
      <remove fileExtension=".data" /><mimeMap fileExtension=".data" mimeType="application/octet-stream" />
      <remove fileExtension=".py" /><mimeMap fileExtension=".py" mimeType="text/plain" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".map" /><mimeMap fileExtension=".map" mimeType="application/json" />
      <remove fileExtension=".bz2" /><mimeMap fileExtension=".bz2" mimeType="application/octet-stream" />
      <remove fileExtension=".tif" /><mimeMap fileExtension=".tif" mimeType="application/octet-stream" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
