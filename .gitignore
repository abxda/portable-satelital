# === Entornos / build ===
.venv/
venv/
__pycache__/
*.pyc
# SOLO el dist/ de la raiz (artefactos de build). OJO: NO usar "dist/" a secas:
# se tragaria satlab-launcher/frontend/dist (la UI embebida) y el CI compila
# un launcher SIN ventana (bug real de v0.1.0).
/dist/
*.exe
sat-launcher
meta-launcher
# binarios compilados de Wails (los assets de build/ SI se versionan: el CI los usa)
satlab-launcher/build/bin/
# bindings JS autogenerados por wails
satlab-launcher/frontend/wailsjs/

# === Portables / artefactos pesados (no van a git; van a HF/LFS) ===
*.tar.gz
*.tgz
/python/
notebooks/data/

